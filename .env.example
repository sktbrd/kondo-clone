# 0x Swap API v2 - get at https://0x.org/docs
ZEROX_API_KEY=your_0x_api_key_here

# Alchemy API key - get at https://alchemy.com
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_key_here

# Chain ID (Base mainnet = 8453)
NEXT_PUBLIC_CHAIN_ID=8453

# Fee recipient address (receives 3% integrator fee)
NEXT_PUBLIC_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# WalletConnect Project ID (optional) - get at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id
